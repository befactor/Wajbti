// Wajbti — Prisma schema
// Provider is Postgres to match production (Supabase). For local dev,
// point DATABASE_URL at any Postgres instance (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth Prisma adapter shape) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set only for email/password sign-up

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  waterSettings WaterSettings?
  mealEntries   MealEntry[]
  corrections   Correction[]
  waterLogs     WaterLog[]
  mealPlans     MealPlan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Profile / BMR-TDEE-BMI ----------

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sex           String? // male | female
  ageYears      Int?
  heightCm      Float?
  weightKg      Float?
  activityLevel String? // sedentary | light | moderate | active | very_active
  goal          String? // lose | maintain | gain

  bmr                Float?
  tdee               Float?
  dailyCalorieTarget Float?
  dailyWaterTargetMl Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Diary ----------

model MealEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime // day this entry belongs to (UTC midnight)
  slot        String // breakfast | lunch | dinner | snack
  description String?
  inputType   String // image | text

  items Json // full analyzed items array (food_name, portion_breakdown, macros, ...)

  totalCalories  Float
  totalProteinG  Float
  totalCarbsG    Float
  totalFatG      Float
  totalFiberG    Float?
  totalSugarG    Float?
  totalSodiumMg  Float?
  aiTip          String?
  swapSuggestion String?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ---------- Correction feedback loop (RAG) ----------

model Correction {
  id     String @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  originalDescription String
  correctedFoodName   String

  createdAt DateTime @default(now())

  @@index([originalDescription])
}

// ---------- Water tracking ----------

model WaterSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyGoalMl      Int
  remindersEnabled Boolean   @default(true)
  reminderCount    Int       @default(6)
  startHour        Int       @default(8)
  endHour          Int       @default(22)
  snoozedUntil     DateTime?
}

model WaterLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime // day this log belongs to (UTC midnight)
  amountMl Int

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ---------- Meal planning ----------

model MealPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate      DateTime
  targetCalories Float
  goal           String
  days           Json // array of { day_label, target_calories, meals: [...] }
  notes          String?

  createdAt DateTime @default(now())
}
