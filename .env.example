# Claude API (required)
ANTHROPIC_API_KEY=

# Database (required from Phase 1 onward)
# Local dev default (SQLite, no setup needed): file:./dev.db
# Production (Supabase Postgres): postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=file:./dev.db

# NextAuth (required from Phase 2 onward)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Sign-In (optional until you create OAuth credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (optional - requires an active Apple Developer account)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
